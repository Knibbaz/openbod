# De publieke URL van deze instantie, zonder slash aan het eind.
# Wordt gebruikt voor de CORS-origin, de JWT-issuer en de magic link.
PUBLIC_URL=https://demo.example.nl

# Waar de container naar luistert. Standaard alleen op localhost, zodat je er
# bewust een TLS-proxy voor moet zetten. Zet op 0.0.0.0 als je host dat regelt.
BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080

# Gedeeld geheim tussen core en identity voor de automatische verstrekking van
# het biedlogboek (E4-S3). De core stuurt pseudonieme subjects naar identity,
# die als enige de koppeling naar een e-mailadres heeft. Zonder dit geheim zou
# dat endpoint een uitvraagorakel zijn. Genereer er een eigen:
#   openssl rand -hex 32
DELIVERY_SHARED_SECRET=vervang-dit-door-een-eigen-willekeurig-geheim

# Geheim waarmee een e-mailadres naar een pseudonieme sub gaat. Zonder pepper is
# zo'n sub gewoon terug te rekenen uit een lijst kandidaat-adressen, en dan is de
# claim dat de core geen identiteiten kent niet waar te maken. In productie start
# de identity-backend niet zonder. Minimaal 32 bytes:
#   openssl rand -hex 32
IDENTITY_SUBJECT_PEPPER=vervang-dit-door-een-eigen-willekeurig-geheim-van-minstens-32-bytes
