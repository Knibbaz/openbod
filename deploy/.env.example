# De publieke URL van deze instantie, zonder slash aan het eind.
# Wordt gebruikt voor de CORS-origin, de JWT-issuer en de magic link.
PUBLIC_URL=https://demo.example.nl

# Waar de container naar luistert. Standaard alleen op localhost, zodat je er
# bewust een TLS-proxy voor moet zetten. Zet op 0.0.0.0 als je host dat regelt.
BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080

# Gedeeld geheim tussen core en identity voor de automatische verstrekking van
# het biedlogboek (E4-S3). De core stuurt pseudonieme subjects naar identity,
# die als enige de koppeling naar een e-mailadres heeft. Zonder dit geheim zou
# dat endpoint een uitvraagorakel zijn. Genereer er een eigen:
#   openssl rand -hex 32
DELIVERY_SHARED_SECRET=vervang-dit-door-een-eigen-willekeurig-geheim

# Geheim waarmee een e-mailadres naar een pseudonieme sub gaat. Zonder pepper is
# zo'n sub gewoon terug te rekenen uit een lijst kandidaat-adressen, en dan is de
# claim dat de core geen identiteiten kent niet waar te maken. In productie start
# de identity-backend niet zonder. Minimaal 32 bytes:
#   openssl rand -hex 32
IDENTITY_SUBJECT_PEPPER=vervang-dit-door-een-eigen-willekeurig-geheim-van-minstens-32-bytes

# Draait dit een demonstratie of een echte instantie? Standaard uit.
#
# Aan (true) doet twee dingen tegelijk, en beide horen alleen bij verzonnen
# woningen: de core vult zichzelf met een scenario en wist zichzelf elk half
# uur, en de identity-backend toont de magic link op het scherm in plaats van
# hem te mailen. Dat laatste betekent dat iedereen kan inloggen als elk
# e-mailadres, dus op een instantie waar echte biedingen binnenkomen is dit
# een open deur.
#
# Een echte instantie laat dit uit staan en heeft dan wel een mailserver nodig
# om magic links te versturen.
DEMO_INSTANCE=false

# Ondertekensleutel van de instantie (Ed25519, PKCS8-PEM). Hiermee tekent de
# core ontvangstbewijzen en logboeken. Laat je dit leeg, dan maakt de core bij
# elke start een nieuwe, en dan is een logboek dat iemand gisteren downloadde
# vandaag niet meer te verifieren: de handtekening hoort dan bij een sleutel die
# niet meer bestaat. Maak er een en plak hem als één regel met \n:
#   openssl genpkey -algorithm ed25519 | awk '{printf "%s\\n", $0}'
CORE_SIGNING_KEY=

# Ondertekensleutel voor inlogtokens (private JWK, ES256, als één regel JSON).
# Zonder deze is iedereen na een herstart uitgelogd. Maak er een met:
#   node -e "const {generateKeyPair,exportJWK}=require('jose');const {randomUUID}=require('crypto');generateKeyPair('ES256',{extractable:true}).then(async k=>console.log(JSON.stringify({...await exportJWK(k.privateKey),alg:'ES256',kid:randomUUID()})))"
IDENTITY_SIGNING_JWK=

# Waar de biedingen en de bekende subjects blijven staan, binnen de container.
# Deze paden wijzen naar de Docker-volumes core-data en identity-data, en dat is
# wat een herstart overleeft. Laat ze staan tenzij je weet waarom je ze wijzigt.
#
# Let op: dit vervangt geen back-up. Een volume overleeft een reboot en een
# `up -d`, maar geen `down -v` en geen kapotte schijf. Zie deploy/README.md.
CORE_DB_PATH=/data/openbod.db
IDENTITY_DB_PATH=/data/identity.db

# Draait er al een proxy (Caddy, Traefik) in Docker voor andere sites? Zet dan
# de Docker-naam van het netwerk van die proxy hier neer, en start met het extra
# bestand deploy/docker-compose.proxy.yml erbij. De webcontainer komt dan op dat
# netwerk te staan en de proxy bereikt hem op naam (openbod-demo-web-1:8080),
# zonder poort op de host. Opzoeken met: docker network ls
PROXY_NETWORK=

# Welke gepubliceerde images en welke tag. Laat staan voor de laatste versie,
# of zet OPENBOD_TAG op een versie (bijvoorbeeld v0.2.0) om vast te pinnen of
# terug te rollen. Bouw je zelf met --build, dan doen deze niet ter zake.
OPENBOD_API_IMAGE=basabbink/openbod-api
OPENBOD_WEB_IMAGE=basabbink/openbod-web
OPENBOD_TAG=latest
