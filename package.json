{
  "name": "openbod",
  "private": true,
  "version": "0.1.0",
  "description": "Open, verifieerbare referentie-implementatie voor verzegeld bieden op de woningmarkt",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace packages/core",
    "dev:web": "npm run dev --workspace packages/web-demo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
